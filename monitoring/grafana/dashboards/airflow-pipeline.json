{
  "uid": "transaction-pipeline",
  "title": "Transaction Pipeline",
  "tags": ["airflow", "dbt", "finance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Rows ingested (latest run)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "airflow_rows_ingested",
          "legendFormat": "rows"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Task outcomes (cumulative)",
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(airflow_task_instance_finished{dag_id=\"transaction_pipeline\",state=\"success\"})",
          "legendFormat": "success"
        },
        {
          "refId": "B",
          "expr": "sum(airflow_task_instance_finished{dag_id=\"transaction_pipeline\",state=\"failed\"})",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Task success rate (cumulative)",
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(airflow_task_instance_finished{dag_id=\"transaction_pipeline\",state=\"success\"}) / clamp_min(sum(airflow_task_instance_finished{dag_id=\"transaction_pipeline\"}), 1)",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Task duration by task (p99)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "airflow_task_duration{dag_id=\"transaction_pipeline\",quantile=\"0.99\"}",
          "legendFormat": "{{task_id}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DAG run duration",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "airflow_dagrun_duration_success{dag_id=\"transaction_pipeline\",quantile=\"0.99\"}",
          "legendFormat": "success p99"
        },
        {
          "refId": "B",
          "expr": "airflow_dagrun_duration_failed{dag_id=\"transaction_pipeline\",quantile=\"0.99\"}",
          "legendFormat": "failed p99"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rows ingested per run",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 20, "showPoints": "always", "drawStyle": "bars" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "airflow_rows_ingested",
          "legendFormat": "rows ingested"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Scheduler delay (how late a run started)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "airflow_dagrun_schedule_delay{dag_id=\"transaction_pipeline\",quantile=\"0.99\"}",
          "legendFormat": "schedule delay p99"
        }
      ]
    }
  ]
}
