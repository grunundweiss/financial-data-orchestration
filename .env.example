# Copy this file to `.env` (gitignored) and fill in real values before running
# `docker compose up`. Never commit the real `.env`.
#
# Every value below is required: docker-compose.yml uses `${VAR:?}` expansions,
# so the stack refuses to start rather than falling back to a default that is
# published in this repository. Verify your file first with:
#
#   python security/preflight.py
#
# Generate the random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Linux only: prevents Airflow container-written files from being owned by a uid
# you can't write to. Set this to your host user id: `id -u`.
AIRFLOW_UID=1000

# Airflow metadata database. These are consumed both by the postgres service
# and by the SQLAlchemy connection string, which is composed from them rather
# than hardcoded, so there is one source of truth.
POSTGRES_USER=airflow
POSTGRES_DB=airflow
POSTGRES_PASSWORD=

# Airflow web UI login (http://localhost:8080).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

# Required by Airflow to encrypt connection/variable secrets at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Signs the internal API JWTs Airflow's own components use to talk to each other.
AIRFLOW__API_AUTH__JWT_SECRET=

# Grafana admin login (http://localhost:3000).
GF_SECURITY_ADMIN_PASSWORD=

# Keyed pepper for the HMAC that tokenizes account identifiers at ingestion.
# Changing it changes every token, so treat it as long-lived key material:
# rotating it requires re-tokenizing the warehouse.
ACCOUNT_TOKEN_PEPPER=
