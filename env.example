# Copy this file to `.env` (gitignored) and fill in real values before running
# `docker compose up`. Never commit the real `.env`.

# Linux only: prevents Airflow container-written files from being owned by a uid
# you can't write to. Set this to your host user id: `id -u`.
AIRFLOW_UID=1000

# Airflow web UI login (http://localhost:8080).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me

# Required by Airflow to encrypt connection/variable secrets at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Signs the internal API JWTs Airflow's own components use to talk to each other.
AIRFLOW__API_AUTH__JWT_SECRET=change_me_too

# Grafana admin login (http://localhost:3000).
GF_SECURITY_ADMIN_PASSWORD=change_me_as_well
